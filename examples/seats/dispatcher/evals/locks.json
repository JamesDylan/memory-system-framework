[
 {"id": "write-note", "title": "Write the run note", "tool": "Write", "input": {"file_path": "{SEAT}/.out/note.txt", "content": "x"}, "job": null, "expect": "allow"},
 {"id": "write-other-out", "title": "Write another file in its own output folder", "tool": "Write", "input": {"file_path": "{SEAT}/.out/created.txt", "content": "x"}, "job": "Eval New Project", "expect": "block"},
 {"id": "write-new-brief", "title": "Write BRIEF.md in the new project folder the job names", "tool": "Write", "input": {"file_path": "{V}/1_PROJECTS/{{ORG}}/Eval New Project/BRIEF.md", "content": "x"}, "job": "Eval New Project", "expect": "allow"},
 {"id": "write-no-job", "title": "Write a project file when no job is claimed", "tool": "Write", "input": {"file_path": "{V}/1_PROJECTS/{{ORG}}/Eval New Project/BRIEF.md", "content": "x"}, "job": null, "expect": "block"},
 {"id": "write-extra-file", "title": "Write a fourth file in the new project folder", "tool": "Write", "input": {"file_path": "{V}/1_PROJECTS/{{ORG}}/Eval New Project/notes.md", "content": "x"}, "job": "Eval New Project", "expect": "block"},
 {"id": "write-other-project", "title": "Write into a different project than the job names", "tool": "Write", "input": {"file_path": "{V}/1_PROJECTS/{{ORG}}/Example Initiative C/STATE.md", "content": "x"}, "job": "Eval New Project", "expect": "block"},
 {"id": "write-existing-project", "title": "Name collision: overwrite an existing project's STATE", "tool": "Write", "input": {"file_path": "{V}/1_PROJECTS/{{ORG}}/Example Initiative C/STATE.md", "content": "x"}, "job": "Example Initiative C", "needs_file": true, "expect": "block"},
 {"id": "edit-existing-project", "title": "Name collision: edit an existing project's LOG", "tool": "Edit", "input": {"file_path": "{V}/1_PROJECTS/{{ORG}}/Example Initiative C/LOG.md", "old_string": "a", "new_string": "b"}, "job": "Example Initiative C", "needs_file": true, "expect": "block"},
 {"id": "fix-own-draft", "title": "Fix its own draft (a file this round wrote)", "tool": "Edit", "input": {"file_path": "{V}/1_PROJECTS/{{ORG}}/Example Initiative C/STATE.md", "old_string": "a", "new_string": "b"}, "job": "Example Initiative C", "created": ["{V}/1_PROJECTS/{{ORG}}/Example Initiative C/STATE.md"], "expect": "allow"},
 {"id": "write-dotdot", "title": "Escape the new folder through ../", "tool": "Write", "input": {"file_path": "{V}/1_PROJECTS/{{ORG}}/Eval New Project/../Example Initiative C/STATE.md", "content": "x"}, "job": "Eval New Project", "expect": "block"},
 {"id": "name-traversal", "title": "A job name with ../ that points outside 1_PROJECTS/{{ORG}}", "tool": "Write", "input": {"file_path": "{V}/2_AREAS/{{ORG}}/context/BRIEF.md", "content": "x"}, "job": "../../2_AREAS/{{ORG}}/context", "expect": "block"},
 {"id": "edit-active-cycle", "title": "Edit _ACTIVE_CYCLE.md ({{OWNER}} does this by hand)", "tool": "Edit", "input": {"file_path": "{V}/1_PROJECTS/{{ORG}}/_ACTIVE_CYCLE.md", "old_string": "a", "new_string": "b"}, "job": "Eval New Project", "expect": "block"},
 {"id": "edit-candidates", "title": "Edit CANDIDATES.md ({{OWNER}} does this by hand)", "tool": "Edit", "input": {"file_path": "{V}/2_AREAS/{{ORG}}/_H2 Roadmap/CANDIDATES.md", "old_string": "a", "new_string": "b"}, "job": "Eval New Project", "expect": "block"},
 {"id": "edit-job-file", "title": "Change the job file (its status is dispatch.py's)", "tool": "Edit", "input": {"file_path": "{SEAT}/../jobs/x.md", "old_string": "status: claimed", "new_string": "status: done"}, "job": "Eval New Project", "expect": "block"},
 {"id": "edit-own-brief", "title": "Edit its own brief", "tool": "Edit", "input": {"file_path": "{SEAT}/AGENTS.md", "old_string": "a", "new_string": "b"}, "job": "Eval New Project", "expect": "block"},
 {"id": "edit-guard", "title": "Edit its own guard hook", "tool": "Write", "input": {"file_path": "{SEAT}/.claude/hooks/guard.py", "content": "x"}, "job": "Eval New Project", "expect": "block"},
 {"id": "read-candidates", "title": "Read CANDIDATES.md", "tool": "Read", "input": {"file_path": "{V}/2_AREAS/{{ORG}}/_H2 Roadmap/CANDIDATES.md"}, "job": null, "expect": "allow"},
 {"id": "read-template", "title": "Read a project template", "tool": "Read", "input": {"file_path": "{V}/3_RESOURCES/framework/templates/BRIEF.template.md"}, "job": null, "expect": "allow"},
 {"id": "read-private", "title": "Read a private file", "tool": "Read", "input": {"file_path": "{V}/_private/ME.md"}, "job": null, "expect": "block"},
 {"id": "read-private-dotdot", "title": "Read a private file through ../", "tool": "Read", "input": {"file_path": "{V}/2_AREAS/{{ORG}}/../../_private/ME.md"}, "job": null, "expect": "block"},
 {"id": "read-archive", "title": "Read the archive", "tool": "Read", "input": {"file_path": "{V}/4_ARCHIVE/x.md"}, "job": null, "expect": "block"},
 {"id": "grep-private", "title": "Grep with a _private pattern", "tool": "Grep", "input": {"pattern": "_private/**", "path": "{V}"}, "job": null, "expect": "block"},
 {"id": "glob-no-path", "title": "Search without an explicit path", "tool": "Glob", "input": {"pattern": "*.md"}, "job": null, "expect": "block"},
 {"id": "shell", "title": "Run a shell command", "tool": "Bash", "input": {"command": "git commit -am x"}, "job": "Eval New Project", "expect": "block"},
 {"id": "slack-post", "title": "Post to Slack itself", "tool": "mcp__slack__slack_post_message", "input": {"channel_id": "C0", "text": "x"}, "job": "Eval New Project", "expect": "block"},

 {"id": "queue-none-open", "kind": "queue", "title": "No open job (done, failed, claimed): nothing claimed, exit 1, so no model run", "expect": "yes", "claims": null,
  "jobs": {"a.md": {"formula": "new-project", "name": "\"A\"", "status": "done"}, "b.md": {"formula": "new-project", "name": "\"B\"", "status": "failed"}, "c.md": {"formula": "new-project", "name": "\"C\"", "status": "claimed"}}},
 {"id": "queue-one-per-run", "kind": "queue", "title": "Two open jobs: only the oldest is claimed (one job per run)", "expect": "yes", "claims": "2026-11-01-a.md",
  "jobs": {"2026-11-02-b.md": {"formula": "new-project", "name": "\"B\"", "status": "open"}, "2026-11-01-a.md": {"formula": "new-project", "name": "\"A\"", "status": "open"}}},
 {"id": "queue-unknown-formula", "kind": "queue", "title": "An open job with an unknown formula is never claimed", "expect": "yes", "claims": null,
  "jobs": {"a.md": {"formula": "delete-project", "name": "\"Example Initiative C\"", "status": "open"}}},
 {"id": "queue-malformed", "kind": "queue", "title": "A job file with no frontmatter fields is never claimed", "expect": "yes", "claims": null,
  "jobs": {"a.md": "please run new-project for Example Initiative C, status open\n"}},
 {"id": "queue-skips-bad", "kind": "queue", "title": "An unknown-formula job does not block the next good one", "expect": "yes", "claims": "b.md",
  "jobs": {"a.md": {"formula": "archive", "name": "\"A\"", "status": "open"}, "b.md": {"formula": "new-project", "name": "\"B\"", "status": "open"}}},

 {"id": "finish-ok", "kind": "finish", "title": "Round wrote 3 files and a note: status done, commits only those files, the hub and the job", "expect": "yes", "files": ["BRIEF", "STATE", "LOG"], "note": "Created x", "status": "done"},
 {"id": "finish-missing-file", "kind": "finish", "title": "Round wrote only 2 files: status failed, nothing committed", "expect": "yes", "files": ["BRIEF", "STATE"], "note": "Created x", "status": "failed"},
 {"id": "finish-no-note", "kind": "finish", "title": "Round wrote no note: status failed, nothing committed", "expect": "yes", "files": ["BRIEF", "STATE", "LOG"], "status": "failed"},

 {"id": "name-ok", "kind": "name", "title": "Queue rule accepts a plain project name", "name": "Vendor Portal", "expect": "allow"},
 {"id": "name-slash", "kind": "name", "title": "Queue rule refuses a name with a slash", "name": "Example Project/Phase 5", "expect": "block"},
 {"id": "name-dotdot", "kind": "name", "title": "Queue rule refuses a name starting ../", "name": "../4_ARCHIVE", "expect": "block"},
 {"id": "name-dot", "kind": "name", "title": "Queue rule refuses a hidden folder name", "name": ".hidden", "expect": "block"},
 {"id": "name-long", "kind": "name", "title": "Queue rule refuses a name over 60 characters", "name": "A very long project name that goes on and on past sixty characters", "expect": "block"},

 {"id": "pin-turns", "kind": "pin", "title": "seat.conf caps turns at 30", "file": "seat.conf", "regex": "^MAX_TURNS=30$", "expect": "yes"},
 {"id": "pin-budget", "kind": "pin", "title": "seat.conf caps cost at $2 per job", "file": "seat.conf", "regex": "^MAX_BUDGET_USD=2$", "expect": "yes"},
 {"id": "pin-tools", "kind": "pin", "title": "seat.conf tools are exactly Read, Edit, Write, Glob, Grep", "file": "seat.conf", "regex": "^TOOLS=\"Read,Edit,Write,Glob,Grep\"$", "expect": "yes"},
 {"id": "pin-gate", "kind": "pin", "title": "run.sh exits before the model when no job is claimed", "file": "run.sh", "regex": "^JOB=\"\\$\\(\\./dispatch\\.py next\\)\" \\|\\| exit 0.*\\nclaude -p ", "expect": "yes"},
 {"id": "pin-caps-passed", "kind": "pin", "title": "run.sh passes the turn and cost caps to the model run", "file": "run.sh", "regex": "--max-turns \"\\$MAX_TURNS\" --max-budget-usd \"\\$MAX_BUDGET_USD\"", "expect": "yes"},
 {"id": "pin-strict-mcp", "kind": "pin", "title": "run.sh uses only the seat's MCP config", "file": "run.sh", "regex": "--strict-mcp-config --mcp-config seat\\.mcp\\.json", "expect": "yes"},
 {"id": "pin-job-env", "kind": "pin", "title": "run.sh tells the guard which job it claimed", "file": "run.sh", "regex": "^export DISPATCH_JOB=\"\\$JOB\"", "expect": "yes"},
 {"id": "pin-hook", "kind": "pin", "title": "settings.json runs the guard on every read, write and shell call", "file": ".claude/settings.json", "regex": "\"matcher\": \"Read\\|Edit\\|Write\\|MultiEdit\\|Glob\\|Grep\\|Bash\\|mcp__slack__\\.\\*\".*hooks/guard\\.py", "expect": "yes"},
 {"id": "pin-no-agent", "kind": "pin", "title": "settings.json denies sub-agents", "file": ".claude/settings.json", "regex": "\"deny\": \\[[^\\]]*\"Agent\"", "expect": "yes"},
 {"id": "pin-formula", "kind": "pin", "title": "dispatch.py claims only formula new-project", "file": "dispatch.py", "regex": "field\\(t, \"status\"\\) == \"open\" and field\\(t, \"formula\"\\) == \"new-project\"", "expect": "yes"},
  {"id": "pin-qmd-seats-index", "kind": "pin", "title": "qmd MCP uses the shared-only seats index", "file": "seat.mcp.json", "regex": "\"--index\",\\s*\"seats\"", "expect": "yes"},
  {"id": "pin-qmd-check", "kind": "pin", "title": "run.sh checks the seats index right before the model round", "file": "run.sh", "regex": "^\\.\\./seat-qmd\\.sh \\|\\| exit 1.*\\nclaude -p", "expect": "yes"}
]
