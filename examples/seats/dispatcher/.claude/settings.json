{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read(/{{SHARED_VAULT_PATH}}/1_PROJECTS/**)",
      "Read(/{{SHARED_VAULT_PATH}}/2_AREAS/**)",
      "Read(/{{SHARED_VAULT_PATH}}/3_RESOURCES/**)",
      "Read(/{{SHARED_VAULT_PATH}}/2_AREAS/Agents/dispatcher/.out/**)",
      "Read(/{{SHARED_VAULT_PATH}}/memory_index.md)",
      "Edit(/{{SHARED_VAULT_PATH}}/1_PROJECTS/{{ORG}}/*/*.md)",
      "Write(/{{SHARED_VAULT_PATH}}/1_PROJECTS/{{ORG}}/*/*.md)",
      "Edit(/{{SHARED_VAULT_PATH}}/2_AREAS/Agents/dispatcher/.out/note.txt)",
      "Write(/{{SHARED_VAULT_PATH}}/2_AREAS/Agents/dispatcher/.out/note.txt)",
      "Glob",
      "Grep",
      "mcp__qmd__query",
      "mcp__qmd__get",
      "mcp__qmd__multi_get",
      "mcp__qmd__status"
    ],
    "deny": [
      "Read(/{{SHARED_VAULT_PATH}}/**/_private/**)",
      "Read(/{{SHARED_VAULT_PATH}}/_private/**)",
      "Read(/{{SHARED_VAULT_PATH}}/4_ARCHIVE/**)",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Workflow"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Edit|Write|MultiEdit|Glob|Grep|Bash|mcp__slack__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
          }
        ]
      }
    ]
  }
}
