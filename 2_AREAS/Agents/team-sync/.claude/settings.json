{
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read(/{{SHARED_VAULT_PATH}}/2_AREAS/{{ORG}}/**)",
      "Read(/{{SHARED_VAULT_PATH}}/2_AREAS/Agents/team-sync/.in/**)",
      "Write(/{{SHARED_VAULT_PATH}}/2_AREAS/Agents/team-sync/.out/canvas.md)",
      "Edit(/{{SHARED_VAULT_PATH}}/2_AREAS/Agents/team-sync/.out/canvas.md)",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Read(/{{SHARED_VAULT_PATH}}/**/_private/**)",
      "Read(/{{SHARED_VAULT_PATH}}/_private/**)",
      "Read(/{{SHARED_VAULT_PATH}}/4_ARCHIVE/**)",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Workflow"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.py\""
          }
        ]
      }
    ]
  }
}
